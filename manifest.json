{
  "manifest_version": 3,
  "name": "DirectChange",
  "version": "1.0.0",
  "description": "Shows every price in your own currency, at today's live rate.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.coinbase.com/*",
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "parse.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
